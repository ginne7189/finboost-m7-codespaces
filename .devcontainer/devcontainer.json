{
  "name": "FinBoost M7 Python and Docker",
  "image": "python:3.14-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "remoteUser": "vscode",
  "postCreateCommand": "python configure_lab.py --init",
  "forwardPorts": [
    8000,
    8001,
    8002
  ],
  "portsAttributes": {
    "8000": {
      "label": "Python API",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "Docker API",
      "onAutoForward": "notify"
    },
    "8002": {
      "label": "Docker API changed port",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-containers"
      ]
    }
  }
}
